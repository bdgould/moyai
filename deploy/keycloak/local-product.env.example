# Local existing-product rehearsal with OIDC sign-in through this Keycloak realm.
# local-product.sh copies this to .local/local-product.env on first use and fills
# in ENCRYPTION_KEY. Edit that copy, not this template. Synthetic values only.
# The script loads it with sh, so ${...} references below are expanded.

# Loopback ports for Keycloak, PostgreSQL, S3 and Moyai itself.
MOYAI_KEYCLOAK_PORT=8080
MOYAI_LOCAL_POSTGRES_PORT=55432
MOYAI_LOCAL_S3_PORT=59000
MOYAI_LOCAL_PORT=8787

MOYAI_CORE=pydantic
MOYAI_PRODUCT_MODE=existing
MOYAI_PRODUCT_LOCAL_REHEARSAL=true
MOYAI_RUNTIME_ROLE=standalone
MOYAI_SEPARATE_BROKER=false
MOYAI_COORDINATOR_HANDOFF=false
# Must match a redirect URI in moyai-realm.json (127.0.0.1 or localhost, port 8787).
MOYAI_PUBLIC_URL=http://127.0.0.1:${MOYAI_LOCAL_PORT}

MOYAI_DATABASE_URL=postgresql://moyai:moyai-local-only@127.0.0.1:${MOYAI_LOCAL_POSTGRES_PORT}/moyai_local
MOYAI_DATABASE_SCHEMA=moyai
MOYAI_NATIVE_SCHEMA=moyai_native
MOYAI_SCHEMA_MODE=verify
MOYAI_NATIVE_SCHEMA_MODE=verify
MOYAI_DATABASE_INITIALIZE=false
SESSION_SECRET=synthetic-product-session-secret-local-only
ENCRYPTION_KEY=
MOYAI_NATIVE_ENCRYPTION_KEY=synthetic-native-authority-key-local-only
MOYAI_NATIVE_KEY_FORMAT=sha256-text-fernet-v1
MOYAI_NATIVE_OBJECT_FORMAT=fernet-hmac-sha256-v1
MOYAI_NATIVE_OBJECT_PREFIX=pydantic-v1
MOYAI_NATIVE_TASK_QUEUE=moyai-local-native-v1
# A shared fallback login beside Keycloak; at least 16 characters.
WORKSPACE_PASSWORD=moyai-local-workspace-password

# `moyai dev` starts this local Temporal server itself in rehearsal mode.
TEMPORAL_ENABLED=true
TEMPORAL_TLS=false
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=moyai-local-original-v1

OBJECT_STORAGE_BUCKET=moyai-local
OBJECT_STORAGE_PREFIX=moyai
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:${MOYAI_LOCAL_S3_PORT}
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY_ID=moyai-local
OBJECT_STORAGE_SECRET_ACCESS_KEY=moyai-local-only

OIDC_ISSUER=http://localhost:${MOYAI_KEYCLOAK_PORT}/realms/moyai
OIDC_CLIENT_ID=moyai
OIDC_CLIENT_SECRET=moyai-local-oidc-secret
OIDC_DISPLAY_NAME=Keycloak
ALLOWED_EMAIL_DOMAINS=example.test
ADMIN_EMAILS=admin@example.test

# Sign-in, roles and Settings work without these. Agent turns need a real
# LiteLLM gateway and model, plus Modal (or Lambda) sandbox credentials.
LITELLM_API_BASE=http://127.0.0.1:4000/v1
LITELLM_API_KEY=local-placeholder
# AGENT_MODEL=
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
